          "text": "{\"userDisplayName\":{\"120216000000293163\":\"Mushtaq Alabbasi\",\"120216000000010017\":\"Abdullah Al-Measar\"},\"items\":[{\"priorityName\":\"None\",\"statusType\":0,\"endDate\":\"2026-10-15T20:00:00.000Z\",\"releaseCount\":0,\"isNotesAdded\":false,\"itemNo\":\"122\",\"ownerId\":[\"120216000000010017\",\"120216000000293163\"],\"points\":6,\"itemBlockId\":\"\",\"UDF_CHAR8\":\"\",\"estimationPoints\":13,\"itemName\":\"[ Shared ] خدمة تسجيل وإدارة مديونية الاصدقاء\",\"UDF_CHAR7\":\"\",\"isOverDue\":true,\"projectInfo\":{\"no\":\"37\",\"name\":\"Invoicing MService\",\"id\":\"120216000000593007\"},\"UDF_CHAR6\":\"\",\"startAfter\":\"-1\",\"createdTime\":\"2026-10-28T18:11:24.034Z\",\"isIntegrated\":\"0\",\"sharedType\":1,\"rootItem\":\"\",\"UDF_CHAR5\":\"nidhal\",\"UDF_CHAR4\":\"خدمة تسجيل وإدارة المديونية\",\"UDF_CHAR3\":\"خدمة تسجيل وإدارة المديونية\",\"workhourType\":0,\"projPriorityId\":\"120216000000593033\",\"UDF_ROLLUP8\":\"1\",\"UDF_ROLLUP9\":\"0\",\"isParent\":false,\"cycleTime\":\"-1\",\"UDF_TEXT1\":\"تم إدخال المهمة بالزوهو \",\"userGroupCount\":0,\"UDF_ROLLUP3\":\"05/10/2026 04:00 PM\",\"UDF_ROLLUP4\":\"13\",\"UDF_ROLLUP5\":\"0\",\"completedDate\":\"-1\",\"UDF_ROLLUP6\":\"15/10/2026 11:00 PM\",\"UDF_ROLLUP7\":\"1\",\"commentCount\":0,\"itemId\":\"120216000004656142\",\"sequence\":\"1\",\"sprintId\":\"120216000000593009\",\"UDF_FORMULADBL1\":\"\",\"epicId\":\"\",\"statusId\":\"120216000000003629\",\"sprintInfo\":{\"owner\":\"120216000000010017\",\"no\":\"0\",\"name\":\"Backlog\",\"id\":\"120216000000593009\",\"type\":5},\"parentItem\":\"\",\"projItemTypeId\":\"120216000000593045\",\"itemTypeName\":\"Story\",\"userIdVsWorkhours\":{\"120216000000293163\":\"0\",\"120216000000010017\":\"0\"},\"startDate\":\"2026-10-05T13:00:00.000Z\",\"description\":\"<p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">معلومات\\nمسبقة<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">خدمة\\nالاصدقاء جاهزة وهي لاتسمح لاحد اضافة صديق الا بعد مشاركته رقم <\\/span><span dir=\\\"LTR\\\">QR<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">او\\nالموافقة من صفحة الاصدقاء في بنكي<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">وهي\\nمنفذه في خدمة توقعات كاس العالم وخدمة فرقي<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">**<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">بصفتي** صاحب محل تجاري،&nbsp;&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">**<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">أرغب في** تسجيل مديونية على عميل معروف (صديق\\nمضاف مسبقا&nbsp; خلال مشاركة رمز<\\/span><span dir=\\\"LTR\\\">QR<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\"> &nbsp;)&nbsp;الخاص بحسابه في التطبيق\\nالمالي،&nbsp;&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">**<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">حتى يتمكن** العميل من استلام إشعار بالمبلغ\\nالمستحق عليه وسداده إلكترونيًا، مع ضمان عدم حذف المديونية أو تعديلها دون إتمام\\nالسداد<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">**<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">بصفتي** عميل بالبنك،&nbsp;&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">**<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">أرغب في** تسجيل مديونية على عميل اخر معروف\\n(صديق مضاف مسبقا&nbsp; خلال مشاركة رمز<\\/span><span dir=\\\"LTR\\\">QR<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\"> &nbsp;)&nbsp;الخاص بحسابه في التطبيق\\nالمالي،&nbsp;&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">**<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">حتى يتمكن** العميل من استلام إشعار بالمبلغ\\nالمستحق عليه وسداده إلكترونيًا، مع ضمان عدم حذف المديونية أو تعديلها دون إتمام\\nالسداد<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">### <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">الوصف الوظيفي<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">1. <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يفتح صاحب المحل خدمة *مديونية الأصدقاء*<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">تسجيل\\nمديونية جديدة<\\/span><span dir=\\\"LTR\\\">**.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">2. <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يدخل مبلغ المديونية، والوصف أو سببها، <span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 204, 238)\\\">و��اريخ\\nالاستحقاق إن وجد<\\/span><\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">3. <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يختار العميل من خلال<\\/span><span dir=\\\"LTR\\\">:<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">مسح رمز <\\/span><span dir=\\\"LTR\\\">QR <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">الخاص بحساب العميل، أو<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">مشاركة رابط طلب المديونية مع العميل<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">4. <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يستلم العميل إشعارًا داخل التطبيق يتضمن<\\/span><span dir=\\\"LTR\\\">:<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">اسم التاجر أو المحل<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">قيمة المديونية<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">تفاصيل العملية<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">تاريخ تسجيل المديونية<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">5. <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">لا يستطيع العميل حذف المديونية أو إخفاءها من\\nسجله<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\"><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 204, 238)\\\">6. <\\/span><\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\"><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 204, 238)\\\">يمكن إلغاء المديونية فقط قبل اعتمادها أو وفق\\nصلاحيات محددة، أما بعد اعتمادها فلا تُلغى إلا من خلال<\\/span><\\/span><span dir=\\\"LTR\\\"><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 204, 238)\\\">:<\\/span><\\/span><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 204, 238)\\\"><br/><\\/span><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">سداد المبلغ كاملًا، أو<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\"><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 204, 238)\\\">&nbsp; &nbsp;- <\\/span><\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\"><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 204, 238)\\\">إجراء تصحيح موثق من التاجر أو مسؤول\\nالنظام<\\/span><\\/span><span dir=\\\"LTR\\\"><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 204, 238)\\\">.<\\/span><\\/span><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 204, 238)\\\"><br/><\\/span><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">7. <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يختار العميل المديونية ويضغط على **سداد الآن<\\/span><span dir=\\\"LTR\\\">**.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">8. <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">بعد نجاح عملية الدفع<\\/span><span dir=\\\"LTR\\\">:<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يتم تحويل المبلغ إلى حساب التاجر<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">تتغير حالة المديونية إلى **مسددة<\\/span><span dir=\\\"LTR\\\">**.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يتلقى الطرفان إشعارًا بتأكيد السداد<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp; &nbsp;- <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يحتفظ النظام بسجل العملية ولا\\nيحذفها<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">## <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">حالات المديونية<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">| <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">الحالة | الوصف <\\/span><span dir=\\\"LTR\\\">|<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">|---|---|<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">| <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">مسودة | تم إعداد المديونية ولم يتم إرسالها أو\\nاعتمادها بعد <\\/span><span dir=\\\"LTR\\\">|<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">| <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">بانتظار قبول العميل | تم إرسال الطلب إلى العميل\\nولم يتم تأكيده <\\/span><span dir=\\\"LTR\\\">|<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">| <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">مستحقة | تم اعتماد المديونية وأصبحت واجبة\\nالسداد <\\/span><span dir=\\\"LTR\\\">|<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">| <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">متأخرة | تجاوزت تاريخ الاستحقاق دون سداد <\\/span><span dir=\\\"LTR\\\">|<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">| <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">مسددة جزئيًا | تم دفع جزء من المبلغ <\\/span><span dir=\\\"LTR\\\">|<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">| <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">مسددة | تم دفع كامل المبلغ <\\/span><span dir=\\\"LTR\\\">|<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">| <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">مرفوضة | رفض العميل المديونية قبل اعتمادها <\\/span><span dir=\\\"LTR\\\">|<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">| <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">متنازع عليها | قام أحد الطرفين بفتح اعتراض أو\\nشكوى <\\/span><span dir=\\\"LTR\\\">|<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">## <\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">معايير القبول<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">- **<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">بفرض** أن التاجر مسجل وموثق، **عندما** يسجل\\nمديونية لعميل، **فإن** النظام ينشئ طلب مديونية مرتبطًا بحساب العميل<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">- **<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">بفرض** إرسال المديونية، **عندما** يفتح العميل\\nالإشعار، **فإن**ه يرى المبلغ والتفاصيل واسم التاجر بوضوح<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">- **<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يجب** ألا يتمكن العميل من حذف المديونية المسجلة\\nأو تعديل مبلغها<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">- **<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يجب** أن يظهر للتاجر والعميل سجل واضح لكل عملية\\nإنشاء أو تعديل أو سداد<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">- **<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">عند** سداد المبلغ كاملًا، **يجب** تغيير حالة\\nالمديونية إلى «مسددة» تلقائيًا<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">- **<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">في حال** فشل الدفع، **تبقى** المديونية بحالتها\\nالسابقة مع إظهار سبب فشل العملية إن أمكن<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">- **<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يجب** إرسال إشعار للطرفين بعد نجاح السداد<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\"><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 102, 178)\\\">- **<\\/span><\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\"><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 102, 178)\\\">لا يجوز** اعتماد البدء في تسجيل مديونية على شخص\\nدون موافقة العميل، إذا كانت موافقة العميل مطلوبة حسب سياسة الخدمة في بداية\\nإضافته كصديق<\\/span><\\/span><span class=\\\"highlight\\\" style=\\\"background-color: rgb(255, 102, 178)\\\"><br/><\\/span><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-YE\\\">عند حذف الصديق من قائمة الأصدقاء لايستطيع تسجيل أي مديونية<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">- **<\\/span><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">يجب** توفير آلية اعتراض أو نزاع في حال تسجيل\\nمديونية بالخطأ<\\/span><span dir=\\\"LTR\\\">.<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><span style=\\\"font-size: 12pt; line-height: 115%; font-family: &quot;Arial&quot;, sans-serif\\\" dir=\\\"RTL\\\" lang=\\\"AR-SA\\\"><br style=\\\"page-break-before: always\\\"/>\\n<\\/span><p style=\\\"text-align: left; direction: ltr; unicode-bidi: embed; margin-top: 0px; margin-bottom: 0px\\\" dir=\\\"LTR\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" dir=\\\"RTL\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">السداد<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">كعميل<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">استطيع\\nسداد كل مدخل على حده<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">او\\nاختيار مجموعة من المديونيات المسجله علي من قبل صديق واحد/التاجر<span style=\\\"\\\">&nbsp; <\\/span>وتسديدها مره واحدة بمبلغ الإجمالي <\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">الاشعارات<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">كتاجر\\nاستطيع عمل اشعار بالتطبيق للعميل على كل مدخل على حده<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">او\\nاختيار مجموعة من المديونيات المسجله من قبل صديق واحد/التاجر<span style=\\\"\\\">&nbsp; <\\/span>وعمل اشعار مره واحدة بمبلغ الإجمالي <\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span style=\\\"font-family: &quot;Arial&quot;, sans-serif\\\" lang=\\\"AR-SA\\\">&nbsp;<\\/span><br/><\\/p><p dir=\\\"RTL\\\" style=\\\"margin-top: 0px; margin-bottom: 0px\\\"><span dir=\\\"LTR\\\">&nbsp;<\\/span><br/><\\/p><div><br/><\\/div>\",\"leadTime\":\"-1\",\"sharedItemCount\":0,\"addedVia\":0,\"hasCheckList\":false,\"UDF_CHKBOX2\":\"\",\"duration\":\"9d\",\"UDF_CHKBOX1\":\"\",\"diffDays\":\"9d 5m\",\"statusName\":\"To do\",\"totalWorkhours\":\"0\",\"isDocsAdded\"