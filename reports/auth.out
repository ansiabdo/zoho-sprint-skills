  "count": 83,
  "tools": [
    {
      "name": "ZohoSprints_CreateRelease",
      "description": "Creates a release in a project. The name, start date, end date, and owner IDs are mandatory in the request body. The response returns the created release, including its generated ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "body": {
            "description": "Details of the release to create.",
            "properties": {
              "color": {
                "description": "Color code to apply to the release, as a hexadecimal value.",
                "type": "string"
              },
              "enddate": {
                "description": "Date on which the release should end.",
                "type": "string"
              },
              "goal": {
                "description": "Goal of the release.",
                "type": "string"
              },
              "name": {
                "description": "Name of the release.",
                "type": "string"
              },
              "ownerIds": {
                "description": "IDs of the users to assign as release owners.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "startdate": {
                "description": "Date on which the release should start.",
                "type": "string"
              },
              "statusId": {
                "description": "ID of the stage to place the release in. Pass the ID as a numeric string.",
                "type": "string"
              }
            },
            "required": [
              "enddate",
              "ownerIds",
              "name",
              "startdate"
            ],
            "type": "object"
          },
          "headers": {
            "properties": {
              "X-convert-response": {
                "default": "true",
                "description": "Converts the response into a readable format. Pass true as the value.",
                "type": "string"
              },
              "x-za-ui-version": {
                "default": "v2",
                "description": "Returns the response in the Sprints 2.0 format. Pass v2 as the value.",
                "type": "string"
              }
            },
            "required": [
              "x-za-ui-version",
              "X-convert-response"
            ],
            "type": "object"
          },
          "path_variables": {
            "properties": {
              "projectId": {
                "description": "ID of the project.",
                "type": "string"
              },
              "teamId": {
                "description": "ID of the workspace.",
                "type": "string"
              }
            },
            "required": [
              "teamId",
              "projectId"
            ],
            "type": "object"
          }
        },
        "required": [
          "body",
          "path_variables",
          "headers"
        ]
      }
    },
    {
      "name": "ZohoSprints_GetEpics",
      "description": "Fetches all the epics in a project. Results are paginated, so use the index and range parameters to page through them. Use 'viewtype' to restrict the response to active or archived epics, and 'searchvalue' to match epics by name. Each epic in the response carries the permissions the authenticated user holds on it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "headers": {
            "properties": {
              "X-convert-response": {
                "default": "true",
                "description": "Converts the response into a readable format. Pass true as the value.",
                "type": "string"
              },
              "x-za-ui-version": {
                "default": "v2",
                "description": "Returns the response in the Sprints 2.0 format. Pass v2 as the value.",
                "type": "string"
              }
            },
            "required": [
              "x-za-ui-version",
              "X-convert-response"
            ],
            "type": "object"
          },
          "path_variables": {
            "properties": {
              "projectId": {
                "description": "ID to identify a project.",
                "type": "string"
              },
              "teamId": {
                "description": "ID to identify a workspace.",
                "type": "string"
              }
            },
            "required": [
              "teamId",
              "projectId"
            ],
            "type": "object"
          },
          "query_params": {
            "properties": {
              "action": {
                "default": "data",
                "description": "Parameter used to distinguish API actions. Use action value as 'data' to fetch epics.",
                "type": "string"
              },
              "index": {
                "description": "Index from which value the listing has to start. The minimum value for this parameter is 1.",
                "minimum": 1,
                "type": "integer"
              },
              "range": {
                "description": "Specify the number of records that have to be listed. The maximum value for this parameter is 250.",
                "maximum": 250,
                "type": "integer"
              },
              "searchvalue": {
                "description": "Filters the list to epics whose name matches the search term.",
                "type": "string"
              },
              "viewtype": {
                "description": "Mention the type of epic to fetch. Skip this param to fetch epics of all types. Use 0 - Active Epic, 1 - Archive Epic",
                "enum": [
                  0,
                  1
                ],
                "type": "integer"
              }
            },
            "required": [
              "action",
              "index",
              "range"
            ],
            "type": "object"
          }
        },
        "required": [
          "query_params",
          "path_variables",
          "headers"
        ]
      }
    },
    {
      "name": "ZohoSprints_CreateProject",
      "description": "Creates a project in a workspace. Pass the name, owner, prefix, and layout IDs as query parameters. To base the new project on an existing template, pass the template ID in clonefrom. The response returns the created project, including its generated ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "headers": {
            "properties": {
              "X-convert-response": {
                "default": "true",
                "description": "Converts the response into a readable format. Pass true as the value.",
                "type": "string"
              },
              "x-za-ui-version": {
                "default": "v2",
                "description": "Returns the response in the Sprints 2.0 format. Pass v2 as the value.",
                "type": "string"
              }
            },
            "required": [
              "x-za-ui-version",
              "X-convert-response"
            ],
            "type": "object"
          },
          "path_variables": {
            "properties": {
              "teamId": {
                "description": "ID of the workspace.",
                "type": "string"
              }
            },
            "required": [
              "teamId"
            ],
            "type": "object"
          },
          "query_params": {
            "properties": {
              "clonefrom": {
                "description": "ID of the project template to create the project from. Pass the ID as a numeric string.",
                "type": "string"
              },
              "desc": {
                "description": "Description of the project.",
                "type": "string"
              },
              "enddate": {
                "description": "Date the project is expected to end.",
                "format": "date-time",
                "type": "string"
              },
              "epiclayoutid": {
                "description": "ID of the epic layout to associate with the project. Pass the ID as a numeric string.",
                "type": "string"
              },
              "estimationtype": {
                "description": "Estimation model to use for the project.\n\n 0 - Fibonacci \n\n 1 - Custom",
                "type": "integer"
              },
              "itemlayoutid": {
                "description": "ID of the item layout to associate with the project. Pass the ID as a numeric string.",
                "type": "string"
              },
              "meetinglayoutid": {
                "description": "ID of the meeting layout to associate with the project. Pass the ID as a numeric string.",
                "type": "string"
              },
              "name": {
                "description": "Name of the project.",
                "type": "string"
              },
              "owner": {
                "description": "ID of the user to assign as the project owner. Pass the ID as a numeric string.",
                "type": "string"
              },
              "pointsarr": {
                "description": "Estimation points available in the project. Mandatory when estimationtype is 1 (custom). A maximum of 15 points can be set.",
                "type": "string"
              },
              "prefix": {
                "description": "Prefix shown before item numbers in the project. Maximum of three characters.",
                "type": "string"
              },
              "projectlayoutid": {
                "description": "ID of the project layout to associate with the project. Pass the ID as a numeric string.",
                "type": "string"
              },
              "projgroup": {
                "description": "ID of the project group this project belongs to. Pass the ID as a numeric string.",
                "type": "string"
              },
              "startdate": {
                "description": "Date the project is expected to start.",
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "name",
              "owner",
              "projgroup"
            ],
            "type": "object"
          }
        },
        "required": [
          "query_params",
          "path_variables",
          "headers"
        ]
      }
    },
