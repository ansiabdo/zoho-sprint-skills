    {
      "name": "ZohoSprints_EditChecklist",
      "description": "Edit checklist updates the name, visibility, owner or priority of an existing checklist. To move the checklist into a different group, pass the target group in the 'togroupid' parameter. Edit checklist response returns the updated checklist. 'Change checklist status' marks a checklist as completed, or reopens a completed checklist. Pass 1 in the 'status' parameter to complete the checklist, or 0 to reopen it. Change checklist status response returns only a status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "headers": {
            "properties": {
              "X-convert-response": {
                "default": "true",
