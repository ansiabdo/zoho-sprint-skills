    {
      "name": "ZohoSprints_GetSprints",
      "description": "Fetches the sprints in a project. Results are paginated, so use the index and range parameters to page through them. Use type to restrict the response to upcoming, active, completed, or canceled sprints, and searchvalue to match sprints by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
