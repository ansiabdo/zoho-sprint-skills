                "type": "string"
              },
              "projectId": {
                "description": "ID of the project.",
                "type": "string"
              },
              "sprintId": {
                "description": "ID of the sprint (or) ID of the backlog. Backlog ID can be fetched from 'GetProjectDetails' tool.",
                "type": "string"
              },
              "teamId": {
                "description": "ID of the workspace.",
                "type": "string"
              }
