    {
      "name": "ZohoSprints_GetChecklists",
      "description": "Fetches the checklists in a checklist group. Results are paginated, so use the index and range parameters to page through them. Each checklist in the response carries its owner, priority, completion status, and the permissions the current user holds on it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "headers": {
            "properties": {
