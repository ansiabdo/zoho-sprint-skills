                "type": "string"
              },
              "x-za-ui-version": {
                "default": "v2",
                "description": "Returns the response in the Sprints 2.0 format. Pass v2 as the value.",
                "type": "string"
              }
            },
            "required": [
              "x-za-ui-version",
              "X-convert-response"
            ],
            "type": "object"
          },
          "path_variables": {
            "properties": {
              "clGroupId": {
                "description": "ID of the checklist group.",
                "type": "string"
              },
              "clItemId": {
                "description": "ID of the checklist.",
                "type": "string"
              },
              "itemId": {
                "description": "ID of the work item.",
                "type": "string"
              },
              "projectId": {
                "description": "ID of the project.",
                "type": "string"
              },
              "sprintId": {
                "description": "ID of the sprint (or) ID of the backlog. Backlog ID can be fetched from 'GetProjectDetails' tool.",
                "type": "string"
              },
              "teamId": {
                "description": "ID of the workspace.",
                "type": "string"
              }
            },
            "required": [
              "teamId",
              "projectId",
              "sprintId",
              "itemId",
              "clGroupId",
              "clItemId"
            ],
            "type": "object"
          },
          "query_params": {
            "properties": {
              "action": {
                "description": "Distinguishes between the API actions available on this endpoint. Pass 'editclitem' to update a checklist. Pass 'changestatus' to complete or reopen a checklist.",
                "enum": [
                  "editclitem",
                  "changestatus"
                ],
                "type": "string"
              },
              "clitemname": {
                "description": "New name for the checklist. This parameter is used when the action is 'editclitem'.",
                "type": "string"
              },
              "ownerid": {
                "description": "ID of the user to assign the checklist to. This parameter is used when the action is 'editclitem'.",
                "type": "string"
              },
              "priority": {
                "description": "Priority of the checklist. Pass 0 for none, 1 for low, 2 for medium, or 3 for high. This parameter is used when the action is 'editclitem'.",
                "type": "integer"
              },
              "status": {
                "description": "Completion status to apply. Pass 1 to complete the checklist or 0 to reopen it. Required parameter when the action is 'changestatus'.",
                "type": "integer"
              },
              "togroupid": {
                "description": "ID of the checklist group to move the checklist to. This parameter is used when the action is 'editclitem'.",
                "type": "string"
              },
              "visibility": {
                "description": "Visibility of the checklist. Pass 0 for public or 1 for private. This parameter is used when the action is 'editclitem'.",
                "type": "integer"
              }
            },
            "required": [
              "action"
            ],
            "type": "object"
          }
        },
        "required": [
          "query_params",
          "path_variables",
          "headers"
        ]
      }
