          "query_params": {
            "properties": {
              "action": {
                "default": "data",
                "description": "Distinguishes between the API actions available on this endpoint. Pass 'data' to retrieve checklists.",
                "type": "string"
              },
              "index": {
                "description": "Position in the list from which the results start. The minimum value is 1.",
