    {
      "name": "ZohoSprints_CreateSprint",
      "description": "Creates a sprint in a project. Pass the name, dates, duration, scrum master, and the users who will work on it as query parameters. The response returns the created sprint, including its generated ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "headers": {
            "properties": {
              "X-convert-response": {
                "default": "true",
                "description": "Converts the response into a readable format. Pass true as the value.",
                "type": "string"
              },
              "x-za-ui-version": {
                "default": "v2",
                "description": "Returns the response in the Sprints 2.0 format. Pass v2 as the value.",
                "type": "string"
              }
            },
            "required": [
              "x-za-ui-version",
              "X-convert-response"
            ],
            "type": "object"
          },
          "path_variables": {
            "properties": {
              "projectId": {
                "description": "ID of the project.",
                "type": "string"
              },
              "teamId": {
                "description": "ID of the workspace.",
                "type": "string"
              }
            },
            "required": [
              "teamId",
              "projectId"
            ],
            "type": "object"
          },
          "query_params": {
            "properties": {
              "description": {
                "description": "A short description of the sprint.",
                "type": "string"
              },
              "duration": {
                "description": "Duration of the sprint. Cannot exceed 8 weeks when strict scrum is enabled, or 30 weeks when strict scrum is disabled.",
                "type": "string"
              },
              "enddate": {
                "description": "Date on which the sprint ends.",
                "format": "date-time",
                "type": "string"
              },
              "name": {
                "description": "Name of the sprint.",
                "type": "string"
              },
              "scrummaster": {
                "description": "ID of the user to assign as scrum master. Pass the ID as a numeric string.",
                "type": "string"
              },
              "startdate": {
                "description": "Date on which the sprint starts.",
                "format": "date-time",
                "type": "string"
              },
              "users": {
