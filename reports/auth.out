    {
      "name": "ZohoSprints_ApproveOrUpdateBillingLogHours",
      "description": "Approves or rejects time logs, or changes their billing status. Pass approvelogs in the action parameter together with 'isapproved', or updatebillingstatus together with 'isbillable'. In both cases, pass the logs to act on in logidarr.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "headers": {
            "properties": {
              "X-convert-response": {
                "default": "true",
                "description": "Converts the response into a readable format. Pass true as the value.",
                "type": "string"
              },
              "x-za-ui-version": {
                "default": "v2",
                "description": "Returns the response in the Sprints 2.0 format. Pass v2 as the value.",
                "type": "string"
              }
            },
            "required": [
              "x-za-ui-version",
              "X-convert-response"
            ],
            "type": "object"
          },
          "path_variables": {
            "properties": {
              "projectId": {
                "description": "ID of the project.",
                "type": "string"
              },
              "teamId": {
                "description": "ID of the workspace.",
                "type": "string"
              }
            },
            "required": [
              "teamId",
              "projectId"
            ],
            "type": "object"
          },
          "query_params": {
            "properties": {
              "action": {
                "description": "Parameter used to distinguish API actions. Use 'approvelogs' to approve or reject time logs. Use 'updatebillingstatus' to update billing status of time logs.",
                "enum": [
                  "approvelogs",
                  "updatebillingstatus"
                ],
                "type": "string"
              },
              "isapproved": {
                "description": "Set the approval status of the log hours. False - Rejected, True - Approved. Required when action is 'approvelogs'.",
                "type": "boolean"
              },
              "isbillable": {
                "description": "Set the billability status of the time log. 0 - Non-billable, 1 - Billable. Required when action is 'updatebillingstatus'.",
                "enum": [
                  0,
                  1
                ],
                "type": "integer"
              },
              "logidarr": {
                "description": "Log hour IDs to approve, reject, or update billing status.",
                "type": "string"
              },
              "rejectnotes": {
                "description": "Comments to add when rejecting the log hours.",
                "type": "string"
              }
            },
            "required": [
              "action",
              "logidarr"
            ],
            "type": "object"
          }
